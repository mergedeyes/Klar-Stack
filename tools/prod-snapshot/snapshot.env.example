# Copy to snapshot.env (gitignored via *.env) and fill in.
#
# The storage zone that holds the nightly backups (Bunny dashboard →
# Storage → your backup zone → FTP & API Access). Bunny zones have no
# separate key/secret pair: the zone name doubles as bucket and access key
# id, and the zone password is the secret. The read-only password is
# enough -- this tool never writes to the zone.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=

# S3 endpoint of the zone's main region -- use the same value as the
# db-backup sidecar's S3_ENDPOINT (de-s3 = Falkenstein). Default:
# S3_ENDPOINT=https://de-s3.storage.bunnycdn.com

# Folder inside the zone (the sidecar's S3_PREFIX). Default:
# S3_PREFIX=backups
