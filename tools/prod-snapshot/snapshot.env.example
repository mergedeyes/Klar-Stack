# Copy to snapshot.env (gitignored via *.env) and fill in -- the same values
# the db-backup sidecar uses (deploy/postgres-backup). A read-only key for
# the backup storage zone is enough; this tool never writes to it.
S3_ENDPOINT=https://storage.bunnycdn.com
S3_BUCKET=
S3_PREFIX=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
